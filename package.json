{
  "name": "kingtonfoodbank",
  "version": "1.0.0",
  "description": "Kington Foodbank static site — feature tests for contact details, 404 handling and build numbers.",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node scripts/build.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "serve": "tsx test/support/static-server.ts",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicobject/kingtonfoodbank.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/magicobject/kingtonfoodbank/issues"
  },
  "homepage": "https://github.com/magicobject/kingtonfoodbank#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
